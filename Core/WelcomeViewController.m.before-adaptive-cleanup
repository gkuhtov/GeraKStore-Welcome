@implementation WelcomeViewController

#pragma mark - Lifecycle

- (void)viewDidLoad {
    [super viewDidLoad];

    self.modalPresentationStyle =
        UIModalPresentationFullScreen;

    self.view.backgroundColor =
        UIColor.blackColor;

    self.view.opaque = YES;

    [self setupBackground];
    [self setupDecorations];
    [self setupGlass];
    [self setupInterface];
    [self setupActions];
    [self animateInterface];
    [self startMotionEffects];
}

#pragma mark - Adaptive Layout

- (void)viewDidLayoutSubviews {

    [super viewDidLayoutSubviews];

    self.backgroundGradientLayer.frame =
        self.view.bounds;

    if (self.starsLayer) {

        self.starsLayer.frame =
            self.view.bounds;

        [self layoutStars];
    }

    if (self.mountainsLayer) {

        self.mountainsLayer.frame =
            self.view.bounds;

        [self layoutMountains];
    }
}

- (void)layoutStars {

    if (!self.starsLayer) {
        return;
    }

    CGSize size =
        self.view.bounds.size;

    NSArray *positions = @[
        [NSValue valueWithCGPoint:CGPointMake(0.07, 0.10)],
        [NSValue valueWithCGPoint:CGPointMake(0.17, 0.23)],
        [NSValue valueWithCGPoint:CGPointMake(0.29, 0.08)],
        [NSValue valueWithCGPoint:CGPointMake(0.41, 0.18)],
        [NSValue valueWithCGPoint:CGPointMake(0.54, 0.07)],
        [NSValue valueWithCGPoint:CGPointMake(0.67, 0.20)],
        [NSValue valueWithCGPoint:CGPointMake(0.80, 0.09)],
        [NSValue valueWithCGPoint:CGPointMake(0.93, 0.25)],
        [NSValue valueWithCGPoint:CGPointMake(0.10, 0.39)],
        [NSValue valueWithCGPoint:CGPointMake(0.31, 0.34)],
        [NSValue valueWithCGPoint:CGPointMake(0.52, 0.43)],
        [NSValue valueWithCGPoint:CGPointMake(0.73, 0.36)],
        [NSValue valueWithCGPoint:CGPointMake(0.90, 0.48)],
        [NSValue valueWithCGPoint:CGPointMake(0.06, 0.57)],
        [NSValue valueWithCGPoint:CGPointMake(0.24, 0.51)],
        [NSValue valueWithCGPoint:CGPointMake(0.68, 0.55)],
        [NSValue valueWithCGPoint:CGPointMake(0.94, 0.61)]
    ];

    NSUInteger count =
        MIN(
            positions.count,
            self.starsLayer.sublayers.count
        );

    for (NSUInteger i = 0; i < count; i++) {

        CALayer *star =
            (CALayer *)self.starsLayer.sublayers[i];

        CGPoint normalized =
            [positions[i] CGPointValue];

        star.position =
            CGPointMake(
                normalized.x * size.width,
                normalized.y * size.height
            );
    }
}

- (void)layoutMountains {

    if (!self.mountainsLayer) {
        return;
    }

    CGFloat width =
        self.view.bounds.size.width;

    CGFloat height =
        self.view.bounds.size.height;

    CGFloat mountainWidth =
        width * 1.12;

    UIBezierPath *path =
        [UIBezierPath bezierPath];

    [path moveToPoint:
        CGPointMake(0.0, height * 0.88)];

    [path addLineToPoint:
        CGPointMake(mountainWidth * 0.08, height * 0.76)];

    [path addLineToPoint:
        CGPointMake(mountainWidth * 0.19, height * 0.87)];

    [path addLineToPoint:
        CGPointMake(mountainWidth * 0.32, height * 0.69)];

    [path addLineToPoint:
        CGPointMake(mountainWidth * 0.44, height * 0.82)];

    [path addLineToPoint:
        CGPointMake(mountainWidth * 0.57, height * 0.66)];

    [path addLineToPoint:
        CGPointMake(mountainWidth * 0.69, height * 0.83)];

    [path addLineToPoint:
        CGPointMake(mountainWidth * 0.81, height * 0.71)];

    [path addLineToPoint:
        CGPointMake(mountainWidth * 0.93, height * 0.84)];

    [path addLineToPoint:
        CGPointMake(mountainWidth, height * 0.76)];

    [path addLineToPoint:
        CGPointMake(mountainWidth, height)];

    [path addLineToPoint:
        CGPointMake(0.0, height)];

    [path closePath];

    self.mountainsLayer.path =
        path.CGPath;
}

#pragma mark - Configuration

- (WelcomeConfig *)config {
    return [WelcomeConfig sharedConfig];
